# Defense-in-depth for accidental builds started from the installation root.
# The supported Compose contract uses app/ as its exact build context, so these
# mutable operator-owned directories must never be sent to a Docker builder.
/.git
/config/
/keys/
/projects/
/data/
/backups/

# Local installation settings and generated developer output.
/.env
/.env.*
/app/node_modules/
/app/frontend/dist/
/app/testing/e2e/.auth/
/app/testing/test-results/
/app/testing/playwright-report/
*.crt
*.pem
*.key
*.log
*.tmp
