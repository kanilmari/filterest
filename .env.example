# Filterest local development environment scaffold.
# ./filterest setup fills and validates required local values automatically.
# Optional integration values may remain blank and be configured later.

SITE_NAME=Filterest
SITE_SLUG=filterest
ENVIRONMENT_TYPE=dev
# Written by ./filterest setup: admin or development.
FILTEREST_INSTALL_PROFILE=
# Admin profile enables direct TLS while retaining production-only routes.
FILTEREST_LOCAL_TLS=
BASE_URL=https://localhost:8100
PORT=8100
EASELECT_PORT=8100
APP_PORT=8100
VITE_DEV_PORT=5200
VITE_HMR_PORT=5200
VITE_BACKEND_URL=https://localhost:8100

# TLS for local HTTPS. Generate local-only certificates before running ./ctl.
TLS_CERT_FILE=dev-cert.crt
TLS_KEY_FILE=dev-cert.key

# Database.
DB_HOST=localhost
DB_PORT=5433
DB_SSLMODE=disable
DB_ADMIN_USER=filterest_admin
DB_ADMIN_PASSWORD=replace-me
DB_USER=filterest_admin
DB_NAME=filterest
DB_PASSWORD=replace-me
DB_READONLY_USER=filterest_readonly
DB_READONLY_PASSWORD=replace-me
DB_CONFIDENTIAL_USER=filterest_confidential
DB_CONFIDENTIAL_PASSWORD=replace-me
DB_BASIC_USER=filterest_basic
DB_BASIC_PASSWORD=replace-me
DB_GUEST_USER=filterest_guest
DB_GUEST_PASSWORD=replace-me

# Sessions and auth.
INSTANCE_NAME=filterest-local
SESSION_SECRET_KEY=replace-me-with-32-plus-random-characters
SESSION_KEY=replace-me-with-32-plus-random-characters
SESSION_COOKIE_NAME=filterest_local_session
SESSION_LOG=
# Reserved test users and automated disposable previews only. This is not a
# general-user or environment-wide authentication bypass.
LOGIN_OTP_CODE=
# Normal installations create the first administrator through the guarded
# browser form and ignore these values.
FILTEREST_INITIAL_ADMIN_EMAIL=
FILTEREST_INITIAL_ADMIN_HANDOFF_FILE=data/bootstrap/initial_admin_credentials.txt

# Optional AI/provider integrations. Leave blank unless configured locally.
OPENAI_API_KEY=
OPENAI_API_MODEL=
OPENAI_EMBEDDING_MODEL=
ANTHROPIC_API_KEY=
USE_ANTHROPIC=
AI_TRANSLATOR_SYSTEM_MESSAGE="You are a multilingual UI translator for Filterest. Return only valid JSON translation objects with lang_key, en, fi, ch, and yue fields. Use Traditional Chinese Cantonese for yue. Keep UI labels concise and natural, and use source context to avoid literal table-name translations."
HERE_API_KEY=
POSTMARK_API_KEY=
EMAIL_FROM_ADDRESS=

# Optional payment/service integrations. Leave blank unless configured locally.
MCP_SERVICE_TOKEN=
REGFETCH_WORKER_SERVICE_TOKEN=
MCP_SERVICE_USER_ID=
MCP_SERVICE_USERNAME=
REVOLUT_MERCHANT_API_SECRET_KEY=
REVOLUT_MERCHANT_API_PUBLIC_KEY=
REVOLUT_WEBHOOK_SECRET=
PAYMENT_CALLBACK_SECRET=
SANDBOX_MODE=true

# Runtime toggles.
ENABLE_SQL_MIGRATIONS=
ENABLE_API_LANGUAGE=
MAINTENANCE_MODE=
