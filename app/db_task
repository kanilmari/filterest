#!/bin/bash
# ==============================================================================
# db_task: Database-backed task manager for Filterest
#
# Portable wrapper that calls server_tools/agent_tools/db_task.py
# Source of truth: dev_agent_tasks table via HTTP API
# Backup: auto-dumps to agent_tasks/_db_dump/ on write operations
# ==============================================================================

set -euo pipefail

FILTEREST_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$FILTEREST_ROOT${PYTHONPATH:+:$PYTHONPATH}"
# shellcheck source=server_tools/lib/python_bytecode_cache.sh
source "$FILTEREST_ROOT/server_tools/lib/python_bytecode_cache.sh"
filterest_configure_python_bytecode_cache "$FILTEREST_ROOT"
exec python3 -m server_tools.agent_tools.db_task "$@"
