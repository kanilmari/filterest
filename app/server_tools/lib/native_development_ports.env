# native_development_ports.env
# The loopback port of each checkout's own native development server: the public
# Filterest product on FILTEREST_NATIVE_PORT, and the private Easelect maintenance
# checkout, recognized by its .git and VERSION_EASELECT markers, on
# EASELECT_NATIVE_PORT. Read by native_origin.py, filterest_port_preflight.sh and
# ../scripts/local_filterest_target.cjs, so every tool takes the ports from here.
# A configured APP_PORT, PORT or EASELECT_PORT, or an explicit -p, still wins.
FILTEREST_NATIVE_PORT=8100
EASELECT_NATIVE_PORT=8082
