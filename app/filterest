#!/usr/bin/env bash
# filterest
# Provides one public command surface for setup, administration, maintenance, and QA.
# Bridges the repository root with canonical implementations under server_tools and testing.
# Exists so generated Filterest releases do not need a drawer full of root wrappers.

set -euo pipefail

# Decide before any startup helper; inherited declarations cannot bypass recovery.
FILTEREST_RECOVERY_OUTPUT=0
case "${1:-}" in
    update|restore-database|verify-update-backup|extract-update-backup) FILTEREST_RECOVERY_OUTPUT=1 ;;
    docker)
        case "${2:-}" in
            profile|update-preflight|app-image-id|stop-app|dump-database|restore-database|ready-check)
                FILTEREST_RECOVERY_OUTPUT=1 ;;
            start)
                for argument in "$@"; do
                    case "$argument" in --for-update|--backup|--restore|--restore-db) FILTEREST_RECOVERY_OUTPUT=1 ;; esac
                done
                ;;
        esac
        ;;
    start|ctl)
        for argument in "$@"; do
            case "$argument" in --backup|--restore|--restore-db|backup-all) FILTEREST_RECOVERY_OUTPUT=1 ;; esac
        done
        ;;
esac
export FILTEREST_RECOVERY_OUTPUT
# A sourced settings/helper file cannot turn off an active recovery boundary.
if [[ "$FILTEREST_RECOVERY_OUTPUT" -eq 1 ]]; then readonly FILTEREST_RECOVERY_OUTPUT; fi
if [[ "$FILTEREST_RECOVERY_OUTPUT" -eq 1 ]]; then
    SCRIPT_SOURCE_DIRECTORY="$(dirname -- "${BASH_SOURCE[0]}" 2>/dev/null)" || { printf 'Recovery launcher location unavailable; sensitive details withheld.\n' >&2; exit 1; }
    CANONICAL_FILTEREST_ROOT="$(cd -- "$SCRIPT_SOURCE_DIRECTORY" 2>/dev/null && pwd -P 2>/dev/null)" 2>/dev/null || { printf 'Recovery launcher location unavailable; sensitive details withheld.\n' >&2; exit 1; }
else
    CANONICAL_FILTEREST_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
fi
# Capture implicit shell/interpreter diagnostics as well as explicit output.
if [[ "$FILTEREST_RECOVERY_OUTPUT" -eq 1 && "${BASH_SOURCE[0]}" == "$0" ]]; then
    source "$CANONICAL_FILTEREST_ROOT/server_tools/lib/recovery_process_boundary.sh" >/dev/null 2>&1 || { printf 'Recovery process boundary unavailable; sensitive details withheld.\n' >&2; exit 1; }
    filterest_recovery_process_entry "${BASH_SOURCE[0]}" "$CANONICAL_FILTEREST_ROOT" "$@"
fi

PROJECT_ROOT="${FILTEREST_PROJECT_ROOT_OVERRIDE:-$CANONICAL_FILTEREST_ROOT}"
if [[ "$FILTEREST_RECOVERY_OUTPUT" -eq 1 ]]; then
    source "$CANONICAL_FILTEREST_ROOT/server_tools/lib/installation_records.sh" 2>/dev/null || { printf 'Recovery diagnostic library unavailable; sensitive details withheld.\n' >&2; exit 1; }
    PROJECT_ROOT="$(filterest_recovery_installation_root "$CANONICAL_FILTEREST_ROOT")" || exit 1
fi
# Docker cannot inspect the host checkout. Supply only its current branch, never
# an inherited declaration; detached releases and Gitless copies stay neutral.
export FILTEREST_UPDATE_CHECKOUT_BRANCH="$(git -C "$PROJECT_ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"

RUNTIME_ROOT="$PROJECT_ROOT/runtime"
if [[ -n "${FILTEREST_ROOT:-}" ]]; then
    RUNTIME_ROOT="$FILTEREST_ROOT/data/runtime"
fi
if [[ "$FILTEREST_RECOVERY_OUTPUT" -eq 1 ]]; then
    # Load the scan before environment/cache helpers can diagnose operator values.
    # shellcheck source=server_tools/lib/python_bytecode_cache.sh
    filterest_recovery_source "$PROJECT_ROOT" "$CANONICAL_FILTEREST_ROOT/server_tools/lib/python_bytecode_cache.sh"
    filterest_recovery_utility "$PROJECT_ROOT" filterest_configure_python_bytecode_cache "$CANONICAL_FILTEREST_ROOT"

    # Development commands use the same interpreter that setup populated. Merely
    # naming the venv does not activate it; an unrelated shell Python must not win.
    # Admin-only installs retain their host Python and distro-provided dependencies.
    # shellcheck source=server_tools/lib/project_python_venv.sh
    filterest_recovery_source "$PROJECT_ROOT" "$CANONICAL_FILTEREST_ROOT/server_tools/lib/project_python_venv.sh"
else
    # shellcheck source=server_tools/lib/python_bytecode_cache.sh
    source "$CANONICAL_FILTEREST_ROOT/server_tools/lib/python_bytecode_cache.sh"
    filterest_configure_python_bytecode_cache "$CANONICAL_FILTEREST_ROOT"

    # Development commands use the same interpreter that setup populated. Merely
    # naming the venv does not activate it; an unrelated shell Python must not win.
    # Admin-only installs retain their host Python and distro-provided dependencies.
    # shellcheck source=server_tools/lib/project_python_venv.sh
    source "$CANONICAL_FILTEREST_ROOT/server_tools/lib/project_python_venv.sh"
    # shellcheck source=server_tools/lib/installation_records.sh
    source "$CANONICAL_FILTEREST_ROOT/server_tools/lib/installation_records.sh"
fi
FILTEREST_COMMAND_PYTHON=python3
if [[ -x "$FILTEREST_PROJECT_PYTHON" ]]; then
    FILTEREST_COMMAND_PYTHON="$FILTEREST_PROJECT_PYTHON"
fi

if [[ "$FILTEREST_RECOVERY_OUTPUT" -eq 1 ]]; then
    cd -- "$CANONICAL_FILTEREST_ROOT" 2>/dev/null || { filterest_recovery_diagnostic "$PROJECT_ROOT" 'Could not enter recovery application: %s\n' "$CANONICAL_FILTEREST_ROOT" >&2; exit 1; }
else
    cd "$CANONICAL_FILTEREST_ROOT"
fi

usage() {
    cat <<'USAGE'
Usage: ./filterest <command> [arguments]

Everyday commands:
  docker start                  Install and start the portable Docker stack
  docker stop                   Stop Docker while preserving data volumes
  docker status                 Show application and database container status
  docker logs                   Follow application and database logs
  setup [options]               Install for browser administration or development
  update [options]              Back up and install a published stable release
  start [arguments]             Start with the installed profile (prebuilt or development)
  status [arguments]            Show application and database compatibility
  manager-key generate          Create the protected maintenance control key
  manager-key generate --rotate Replace an existing maintenance control key
  data [arguments]              Maintain datasets through the application API
  language [arguments]          Maintain translations through the application API
  asset-linking [arguments]     Inspect shared media-linking readiness through the API
  maintenance logs [arguments]  Preview or prune application logs through the API
  maintenance data [arguments]  Preview or prune configured data through the API

Developer commands:
  build [arguments]             Build frontend assets without app-local caches
  release prepare [arguments]   Plan or prepare candidate release metadata
  release verify [arguments]    Run the release source checks on this checkout
  release build [arguments]     Assemble verified Linux release assets locally
  release promote [arguments]   Verify a candidate and plan published metadata
  release publish [arguments]   Plan or publish verified assets to GitHub
  qa [arguments]                Run the broader source quality suite
  test-unit [arguments]         Run Vitest frontend and Node unit tests
  database [arguments]          Run a read-only database inspection
  mcp [arguments]               Start the developer MCP server
  test [arguments]              Run Playwright without opening an HTML report
  search <pattern> [path]       Search repository text without a pager
  audit browser [arguments]     Run the browser quality audit
  audit visual [arguments]      Capture/analyze Visual Guardian screenshots
  audit human [arguments]       Prepare or run browser acceptance evidence
  codesize [arguments]          Summarize source file counts, lines, and sizes
  timestamp                     Print the shared project timestamp
  fix-go-imports [arguments]    Run the Go import maintenance helper

The established ./ctl command remains available as a compatibility entrypoint.
USAGE
}

resolve_environment() {
    if [[ -f "$CANONICAL_FILTEREST_ROOT/server_tools/ctl/lib/resolve_env.sh" ]]; then
        # Keep assignments in this shell; recovery source diagnostics use stderr.
        filterest_recovery_source "$PROJECT_ROOT" "$CANONICAL_FILTEREST_ROOT/server_tools/ctl/lib/resolve_env.sh"
        return
    fi

    # A portable canonical source folder does not need the private Easelect ctl
    # tree merely to discover its installed profile or protected env files.
    filterest_recovery_source "$PROJECT_ROOT" "$CANONICAL_FILTEREST_ROOT/server_tools/lib/easelect_private_paths.sh"
    filterest_recovery_utility "$PROJECT_ROOT" easelect_resolve_private_paths "$PROJECT_ROOT"
}

# Prints the install profile this folder records: "docker" from keys/docker.env,
# otherwise the native profile named in the protected native settings.
# Refuses a folder that records both, so no command starts or sets it up the wrong
# way. Callers read it once with a plain assignment: a failure then stops the
# command instead of reading as "no profile", which would start the installer.
installed_profile() {
    local candidate_file=""
    local profile=""
    local docker_profile=""
    local record="" records=""
    local native_records=()

    resolve_environment || return
    docker_profile="$(filterest_docker_install_profile \
        "$CANONICAL_FILTEREST_ROOT/server_tools/run_filterest_docker.sh" "$PROJECT_ROOT")" || return
    if [[ "$docker_profile" == "docker" ]]; then
        if [[ "$FILTEREST_RECOVERY_OUTPUT" -eq 1 ]]; then
            records="$(filterest_native_setup_records "$RUNTIME_ROOT/filterest-setup-complete" \
                "${EASELECT_DEV_ENV_FILE:-}" "${EASELECT_RUNTIME_ENV_FILE:-}")" || return
            while IFS= read -r record; do
                [[ -n "$record" ]] || continue
                native_records+=("$record")
            done <<< "$records"
        else
            while IFS= read -r record; do
                native_records+=("$record")
            done < <(filterest_native_setup_records "$RUNTIME_ROOT/filterest-setup-complete" \
                "${EASELECT_DEV_ENV_FILE:-}" "${EASELECT_RUNTIME_ENV_FILE:-}")
        fi
        filterest_refuse_mixed_installation "$docker_profile" \
            ${native_records[@]+"${native_records[@]}"} || return
        printf 'docker'
        return
    fi
    for candidate_file in "${EASELECT_DEV_ENV_FILE:-}" "${EASELECT_RUNTIME_ENV_FILE:-}"; do
        [[ -f "$candidate_file" ]] || continue
        profile="$(grep -E '^FILTEREST_INSTALL_PROFILE=' "$candidate_file" 2>/dev/null | tail -1 | cut -d'=' -f2- || true)"
        if [[ -n "$profile" ]]; then
            printf '%s' "$profile"
            return
        fi
    done
}

# Reads one non-empty value from the installed public runtime configuration.
# Between the root launcher and protected env files it avoids sourcing secrets
# while still letting startup make narrow profile and safety decisions.
installed_environment_value() {
    local key="$1"
    local candidate_file=""
    local value=""

    resolve_environment
    for candidate_file in "$EASELECT_DEV_ENV_FILE" "$EASELECT_RUNTIME_ENV_FILE"; do
        [[ -f "$candidate_file" ]] || continue
        value="$(grep -E "^${key}=" "$candidate_file" 2>/dev/null | tail -1 | cut -d'=' -f2- || true)"
        if [[ -n "$value" ]]; then
            printf '%s' "$value"
            return
        fi
    done
}

# Enables reviewed pending migrations for a local generated Filterest start.
# Existing public installations can otherwise keep an older reduced schema
# forever because their protected env files intentionally preserve blank
# optional toggles across release refreshes. Explicit operator values and
# remote database hosts remain untouched.
enable_local_public_schema_repairs() {
    local configured_value=""
    local database_host=""

	[[ -f "$CANONICAL_FILTEREST_ROOT/VERSION_APP" ]] || return
    configured_value="$(installed_environment_value ENABLE_SQL_MIGRATIONS)"
    if [[ -n "$configured_value" ]]; then
        export ENABLE_SQL_MIGRATIONS="$configured_value"
        return
    fi

    database_host="$(installed_environment_value DB_HOST)"
    case "${database_host,,}" in
        localhost|127.0.0.1|::1)
            export ENABLE_SQL_MIGRATIONS=true
            export EASELECT_MIGRATION_FILE_ALLOWLIST="20260307_create_system_comments.sql,20260805000001_restore_filterest_public_version_head.sql"
            printf 'Applying pending local Filterest schema repairs before startup.\n'
            ;;
    esac
}

# Reads the profile recorded only after database bootstrap and dependencies finish.
# Between the public start command and the resumable installer it is the durable setup gate.
# Why: environment files can already exist after an interrupted setup, so their presence alone
# must not allow Filterest to skip the remaining installation steps.
completed_setup_profile() {
	local completion_marker="$RUNTIME_ROOT/filterest-setup-complete"
    sed -n 's/^profile=//p' "$completion_marker" 2>/dev/null | head -1 || true
}

# Reports whether a generated Filterest checkout still needs its guided setup.
# Between generated-release identity, protected settings, and the completion marker it detects
# both fresh downloads and interrupted installations without consulting an uninitialized DB.
filterest_setup_is_required() {
    local configured_profile="$1"
    local completed_profile=""

	[[ -f "$CANONICAL_FILTEREST_ROOT/VERSION_APP" ]] || return 1
    completed_profile="$(completed_setup_profile)"
    [[ -n "$configured_profile" && "$configured_profile" == "$completed_profile" ]] && return 1
    return 0
}

# Runs setup automatically when an actual start is requested from an unfinished checkout.
# Between the start command and profile-aware installer it preserves a partial setup's profile
# and lets the installer resume safely before starting the application itself.
run_setup_before_first_start() {
    local profile="$1"
    [[ -n "$profile" ]] || profile="$(completed_setup_profile)"

    printf 'Welcome to Filterest!\n'
    printf "Let's complete the guided setup, then start the application.\n\n"
    if [[ -n "$profile" ]]; then
		filterest_dispatch_child "$CANONICAL_FILTEREST_ROOT/server_tools/install_filterest.sh" --profile "$profile"
	fi
	filterest_dispatch_child "$CANONICAL_FILTEREST_ROOT/server_tools/install_filterest.sh"
}

# Checks the development profile's configured application port before ctl can
# build the server or perform database-backed startup work.
preflight_development_start_port() {
    local port=""
    local default_port=""
    resolve_environment
    # shellcheck source=server_tools/lib/filterest_port_preflight.sh
	filterest_recovery_source "$PROJECT_ROOT" "$CANONICAL_FILTEREST_ROOT/server_tools/lib/filterest_port_preflight.sh"
    default_port="$(filterest_recovery_utility "$PROJECT_ROOT" filterest_native_default_port "$PROJECT_ROOT")"
    port="$(filterest_recovery_utility "$PROJECT_ROOT" filterest_configured_port "$default_port" "$EASELECT_DEV_ENV_FILE" "$EASELECT_RUNTIME_ENV_FILE")"
    filterest_recovery_utility "$PROJECT_ROOT" filterest_preflight_port "$port"
}

# Distinguishes application startup from compatibility actions such as --stop or --help.
# Between the public command arguments and automatic setup it prevents a maintenance action
# from unexpectedly installing packages or creating local runtime state.
start_action_was_requested() {
    [[ "$#" -eq 0 || "${1:-}" == "start" ]]
}

# Direct app/ invocation owns child-startup errors too. Keep the shell until
# scanned stderr is drained; ordinary dispatch retains its original exec path.
filterest_dispatch_child() {
    if [[ "$FILTEREST_RECOVERY_OUTPUT" -eq 1 ]]; then
        if [[ "${FILTEREST_RECOVERY_PROMPT_FD:-}" != 8 ]] || ! { true >&8; } 2>/dev/null; then
            # A root launcher's stderr may already be buffered. Only the fixed
            # confirmation prompt uses its validated original destination.
            if filterest_recovery_scan_matches 2; then
                exec 8>&"$FILTEREST_RECOVERY_STDERR_DESTINATION"
            else
                exec 8>&2
            fi
            export FILTEREST_RECOVERY_PROMPT_FD=8
        fi
        filterest_recovery_scan "$PROJECT_ROOT" stderr filterest_recovery_child "$@"
        exit $?
    fi
    exec "$@"
}

command_name="${1:-help}"
[[ "$#" -eq 0 ]] || shift

case "$command_name" in
    docker)
        filterest_dispatch_child "$CANONICAL_FILTEREST_ROOT/server_tools/run_filterest_docker.sh" "$@"
        ;;
    setup)
        profile="$(installed_profile)"
        if [[ "$profile" == "docker" ]]; then
            printf 'error: this installation runs in Docker; prepare it with ./filterest docker setup, or start it with ./filterest docker start\n' >&2
            exit 2
        fi
        # Setup is already owned by the canonical Filterest source even while
        # unrelated lifecycle commands still use outer Easelect bridges.
        exec "$CANONICAL_FILTEREST_ROOT/server_tools/install_filterest.sh" "$@"
        ;;
    update)
        filterest_dispatch_child "$CANONICAL_FILTEREST_ROOT/server_tools/update_filterest.sh" "$@"
        ;;
    restore-database)
        profile="$(installed_profile)"
        if [[ "$profile" == "docker" ]]; then
            filterest_dispatch_child "$CANONICAL_FILTEREST_ROOT/server_tools/run_filterest_docker.sh" restore-database "$@"
        fi
        resolve_environment
        filterest_recovery_python "$PROJECT_ROOT" "$FILTEREST_COMMAND_PYTHON" "$CANONICAL_FILTEREST_ROOT/server_tools/lib/database_recovery.py" restore \
            --root "$PROJECT_ROOT" --profile native \
            --settings "$EASELECT_DEV_ENV_FILE" --settings "$EASELECT_RUNTIME_ENV_FILE" "$@"
        ;;
    verify-update-backup|extract-update-backup)
        # Read-only verification must not create Python caches or call Docker.
        export PYTHONDONTWRITEBYTECODE=1
        profile="$(installed_profile)"
        action=verify
        [[ "$command_name" != extract-update-backup ]] || action=extract
        cd -- "$PROJECT_ROOT" 2>/dev/null || { filterest_recovery_diagnostic "$PROJECT_ROOT" 'Could not enter recovery installation: %s\n' "$PROJECT_ROOT" >&2; exit 1; }
        if [[ "$profile" == docker ]]; then
            filterest_recovery_python "$PROJECT_ROOT" "$FILTEREST_COMMAND_PYTHON" "$CANONICAL_FILTEREST_ROOT/server_tools/lib/database_recovery_update.py" "$action" \
                --root "$PROJECT_ROOT" --profile docker "$@"
            exit $?
        fi
        resolve_environment
        filterest_recovery_python "$PROJECT_ROOT" "$FILTEREST_COMMAND_PYTHON" "$CANONICAL_FILTEREST_ROOT/server_tools/lib/database_recovery_update.py" "$action" \
            --root "$PROJECT_ROOT" --profile native \
            --settings "$EASELECT_DEV_ENV_FILE" --settings "$EASELECT_RUNTIME_ENV_FILE" "$@"
        ;;
    start|ctl)
        profile="$(installed_profile)"
        if [[ "$profile" == "docker" ]]; then
            if [[ "${1:-}" == "--stop" ]]; then
                printf 'error: this installation runs in Docker; stop it with ./filterest docker stop\n' >&2
                exit 2
            fi
            filterest_dispatch_child "$CANONICAL_FILTEREST_ROOT/server_tools/run_filterest_docker.sh" start "$@"
        fi
        if start_action_was_requested "$@" && filterest_setup_is_required "$profile"; then
            run_setup_before_first_start "$profile"
        fi
        if start_action_was_requested "$@"; then
            enable_local_public_schema_repairs
        fi
        if [[ "$profile" == "admin" ]]; then
			filterest_dispatch_child "$CANONICAL_FILTEREST_ROOT/server_tools/run_filterest_admin.sh" "$@"
        fi
        if start_action_was_requested "$@"; then
            preflight_development_start_port
        fi
		filterest_dispatch_child "$CANONICAL_FILTEREST_ROOT/ctl" "$@"
        ;;
    status)
        profile="$(installed_profile)"
        if [[ "$profile" == "docker" ]]; then
            exec "$CANONICAL_FILTEREST_ROOT/server_tools/run_filterest_docker.sh" status "$@"
        fi
        resolve_environment
        exec "$FILTEREST_COMMAND_PYTHON" "$CANONICAL_FILTEREST_ROOT/server_tools/agent_tools/dev_status.py" "$@"
        ;;
    manager-key)
        manager_key_action="${1:-}"
        [[ "$#" -eq 0 ]] || shift
        case "$manager_key_action" in
            generate)
                resolve_environment
                exec "$FILTEREST_COMMAND_PYTHON" "$CANONICAL_FILTEREST_ROOT/server_tools/system_manager_token_creator.py" \
                    generate \
                    --env-file "$EASELECT_RUNTIME_ENV_FILE" \
                    "$@"
                ;;
            *)
                printf 'error: manager-key requires generate\n' >&2
                exit 2
                ;;
        esac
        ;;
    data)
        resolve_environment
        exec "$FILTEREST_COMMAND_PYTHON" "$CANONICAL_FILTEREST_ROOT/server_tools/agent_tools/api_crud.py" "$@"
        ;;
    language)
        resolve_environment
        exec "$FILTEREST_COMMAND_PYTHON" "$CANONICAL_FILTEREST_ROOT/server_tools/agent_tools/api_lang.py" "$@"
        ;;
    asset-linking)
        resolve_environment
        exec "$FILTEREST_COMMAND_PYTHON" "$CANONICAL_FILTEREST_ROOT/server_tools/agent_tools/api_asset_linking.py" "$@"
        ;;
    database)
        resolve_environment
        exec "$FILTEREST_COMMAND_PYTHON" "$CANONICAL_FILTEREST_ROOT/server_tools/agent_tools/db.py" "$@"
        ;;
    maintenance)
        maintenance_name="${1:-}"
        [[ "$#" -eq 0 ]] || shift
        resolve_environment
        case "$maintenance_name" in
            logs)
                exec "$FILTEREST_COMMAND_PYTHON" "$CANONICAL_FILTEREST_ROOT/server_tools/agent_tools/db_log_retention.py" "$@"
                ;;
            data)
                exec "$FILTEREST_COMMAND_PYTHON" "$CANONICAL_FILTEREST_ROOT/server_tools/agent_tools/db_data_retention.py" "$@"
                ;;
            *)
                printf 'error: maintenance requires logs or data\n' >&2
                exit 2
                ;;
        esac
        ;;
    mcp)
        resolve_environment
        export FILTEREST_MCP_DISPLAY_COMMAND="${FILTEREST_MCP_DISPLAY_COMMAND:-$0 mcp}"
        exec "$FILTEREST_COMMAND_PYTHON" "$CANONICAL_FILTEREST_ROOT/server_tools/agent_tools/easelect_mcp_server.py" "$@"
        ;;
    release)
        release_action="${1:-}"
        [[ "$#" -eq 0 ]] || shift
        case "$release_action" in
            prepare)
                exec "$FILTEREST_COMMAND_PYTHON" "$CANONICAL_FILTEREST_ROOT/server_tools/release/prepare_release.py" "$@"
                ;;
            verify)
                exec "$FILTEREST_COMMAND_PYTHON" "$CANONICAL_FILTEREST_ROOT/server_tools/release/verify_source.py" "$@"
                ;;
            build)
                exec "$CANONICAL_FILTEREST_ROOT/server_tools/release/build_assets.sh" "$@"
                ;;
            promote)
                exec "$FILTEREST_COMMAND_PYTHON" "$CANONICAL_FILTEREST_ROOT/server_tools/release/promote_release.py" "$@"
                ;;
            publish)
                exec "$FILTEREST_COMMAND_PYTHON" "$CANONICAL_FILTEREST_ROOT/server_tools/release/publish_release.py" "$@"
                ;;
            *)
                printf 'error: release requires prepare, verify, build, promote or publish\n' >&2
                exit 2
                ;;
        esac
        ;;
    build)
        exec npm --prefix "$CANONICAL_FILTEREST_ROOT" run build -- "$@"
        ;;
    qa)
        exec npm --prefix "$CANONICAL_FILTEREST_ROOT" run qa -- "$@"
        ;;
    test-unit)
        exec npm --prefix "$CANONICAL_FILTEREST_ROOT" test -- "$@"
        ;;
    test)
		exec "$CANONICAL_FILTEREST_ROOT/server_tools/scripts/safe_test.sh" "$@"
        ;;
    search)
		exec "$CANONICAL_FILTEREST_ROOT/server_tools/scripts/safe_grep.sh" "$@"
        ;;
    audit)
        audit_name="${1:-}"
        [[ "$#" -eq 0 ]] || shift
        case "$audit_name" in
            browser)
                resolve_environment
				exec node "$CANONICAL_FILTEREST_ROOT/server_tools/scripts/browser_audit.mjs" "$@"
                ;;
            visual)
				exec "$CANONICAL_FILTEREST_ROOT/server_tools/scripts/guardian.sh" "$@"
                ;;
            human)
                qa_name="${1:-}"
                resolve_environment
                case "$qa_name" in
                    ai-test)
						exec node "$CANONICAL_FILTEREST_ROOT/server_tools/scripts/ai_acceptance_test.mjs" "$@"
                        ;;
                    computer-use-test)
						exec node "$CANONICAL_FILTEREST_ROOT/server_tools/scripts/computer_use_acceptance_test.mjs" "$@"
                        ;;
                    *)
						exec node "$CANONICAL_FILTEREST_ROOT/server_tools/scripts/human_qa.mjs" "$@"
                        ;;
                esac
                ;;
            *)
                printf 'error: audit requires browser, visual, or human\n' >&2
                exit 2
                ;;
        esac
        ;;
    timestamp)
		exec "$FILTEREST_COMMAND_PYTHON" "$CANONICAL_FILTEREST_ROOT/server_tools/scripts/timestamp.py" "$@"
        ;;
    codesize)
        exec "$FILTEREST_COMMAND_PYTHON" "$CANONICAL_FILTEREST_ROOT/server_tools/scripts/codesize.py" "$@"
        ;;
    fix-go-imports)
        exec node "$CANONICAL_FILTEREST_ROOT/server_tools/scripts/fix_go_imports.js" "$@"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        filterest_recovery_diagnostic "$PROJECT_ROOT" 'error: unknown Filterest command: %s\n\n' "$command_name" >&2
        usage >&2
        exit 2
        ;;
esac
