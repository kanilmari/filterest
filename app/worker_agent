#!/bin/bash
# ==============================================================================
# worker_agent: Filterest Worker Agent Shortcut
#
# Delegate tasks to a background AI worker.
# Default backend configured in server_tools/agent_tools/worker_agent_defaults.sh
# Thin wrapper that calls server_tools/agent_tools/worker_agent/worker_agent_core.sh
#
# Usage:
#   ./worker_agent "do something"                       # uses default backend
#   ./worker_agent family=claude "do something"         # force Claude
#   ./worker_agent family=codex "do something"          # force Codex
#   ./worker_agent --prompt-file path/to/prompt.md      # prompt from file
#   ./worker_agent --ticket agent_tasks/_db_dump/<id-slug>/ticket.md
#   echo "do something" | ./worker_agent -              # stdin
#   ./worker_agent --routine documentation_audit        # run a multi-step routine
#   ./worker_agent --routine --list                     # list available routines
#   ./worker_agent --list                               # list recent runs
#   ./worker_agent --status <task_id>                   # check run status
#   ./worker_agent --wait [task_id]                     # block until task completes
#   ./worker_agent --help                               # show usage
# ==============================================================================

set -euo pipefail

FILTEREST_APPLICATION_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ -z "${FILTEREST_WORKSPACE_ROOT:-}" ]] && \
    [[ "$(basename "$FILTEREST_APPLICATION_ROOT")" == "app" ]] && \
    [[ -f "$FILTEREST_APPLICATION_ROOT/go.mod" ]] && \
    [[ -f "$FILTEREST_APPLICATION_ROOT/VERSION_APP" ]]; then
    FILTEREST_INSTALLATION_ROOT="$(cd "$FILTEREST_APPLICATION_ROOT/.." && pwd -P)"
    FILTEREST_OUTER_ROOT="$(cd "$FILTEREST_INSTALLATION_ROOT/.." && pwd -P)"
    if [[ -e "$FILTEREST_OUTER_ROOT/.git" && -f "$FILTEREST_OUTER_ROOT/VERSION_EASELECT" ]]; then
        export FILTEREST_WORKSPACE_ROOT="$FILTEREST_OUTER_ROOT"
        export FILTEREST_RUNTIME_ROOT_OVERRIDE="$FILTEREST_OUTER_ROOT/runtime"
        export FILTEREST_WORKER_DEV_PORT="${FILTEREST_WORKER_DEV_PORT:-8082}"
        export FILTEREST_WORKER_DB_PORT="${FILTEREST_WORKER_DB_PORT:-5433}"
        export FILTEREST_DATABASE_DISPLAY_COMMAND="${FILTEREST_DATABASE_DISPLAY_COMMAND:-./filterest_private/db}"
    else
        export FILTEREST_ROOT="$FILTEREST_INSTALLATION_ROOT"
        export FILTEREST_WORKSPACE_ROOT="$FILTEREST_INSTALLATION_ROOT"
        export FILTEREST_RUNTIME_ROOT_OVERRIDE="$FILTEREST_INSTALLATION_ROOT/data/runtime"
        export FILTEREST_TEST_CREDENTIAL_FILE="${FILTEREST_TEST_CREDENTIAL_FILE:-$FILTEREST_INSTALLATION_ROOT/keys/filterest_runtime/dev_env_test_creds.txt}"
        export FILTEREST_WORKER_OUTPUT_DIR_REL="${FILTEREST_WORKER_OUTPUT_DIR_REL:-data/runtime/agent_tasks/_artifacts/worker_runs}"
        export FILTEREST_WORKER_LEGACY_OUTPUT_DIR_REL="${FILTEREST_WORKER_LEGACY_OUTPUT_DIR_REL:-data/runtime/agent_tasks/20_in_progress}"
        export FILTEREST_WORKER_DEV_PORT="${FILTEREST_WORKER_DEV_PORT:-8100}"
        export FILTEREST_WORKER_DB_PORT="${FILTEREST_WORKER_DB_PORT:-5432}"
        export FILTEREST_DATABASE_DISPLAY_COMMAND="${FILTEREST_DATABASE_DISPLAY_COMMAND:-./filterest database}"
        export GOWORK=off
        unset FILTEREST_WORKER_ROUTINE_RUNNER FILTEREST_WORKER_ROUTINES_DIR
    fi
else
    export FILTEREST_WORKSPACE_ROOT="${FILTEREST_WORKSPACE_ROOT:-$FILTEREST_APPLICATION_ROOT}"
fi
# shellcheck source=server_tools/lib/python_bytecode_cache.sh
source "$FILTEREST_APPLICATION_ROOT/server_tools/lib/python_bytecode_cache.sh"
filterest_configure_python_bytecode_cache "$FILTEREST_APPLICATION_ROOT"

WORKER_DIR="$FILTEREST_APPLICATION_ROOT/server_tools/agent_tools/worker_agent"
COMP_SCRIPT="$WORKER_DIR/worker_agent_completions.bash"

# --setup-completion: install tab-completion permanently
if [[ "${1:-}" == "--setup-completion" ]]; then
    COMP_DIR="$HOME/.local/share/bash-completion/completions"
    mkdir -p "$COMP_DIR"
    cp "$COMP_SCRIPT" "$COMP_DIR/worker_agent"
    echo "✓ Completion installed to $COMP_DIR/worker_agent"
    # Also source it into the current shell if possible
    echo ""
    echo "To activate NOW in this terminal, run:"
    echo "  source $COMP_SCRIPT"
    echo ""
    echo "New terminals will auto-load completions."
    exit 0
fi

# Route --routine to the routine runner, everything else to the core
if [[ "${1:-}" == "--routine" ]]; then
    shift
    if [[ -z "${FILTEREST_WORKER_ROUTINE_RUNNER:-}" || ! -f "$FILTEREST_WORKER_ROUTINE_RUNNER" ]]; then
        echo "Error: This Filterest checkout has no project-specific worker routines configured." >&2
        exit 2
    fi
    exec bash "$FILTEREST_WORKER_ROUTINE_RUNNER" "$@"
else
    exec bash "$WORKER_DIR/worker_agent_core.sh" "$@"
fi
