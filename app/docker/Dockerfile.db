FROM pgvector/pgvector:pg16

USER root

# Keep pgvector from the base image and add PostGIS packages so derivative
# instances can materialize PostGIS-backed tables during sync.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-16-postgis-3=3.6.4+dfsg-2.pgdg12+1 \
        postgresql-16-postgis-3-scripts=3.6.4+dfsg-2.pgdg12+1 \
    && rm -rf /var/lib/apt/lists/*

# The official entrypoint starts as root only long enough to set the ownership
# of a host bind-mounted PostgreSQL data directory, then drops to postgres.
# This keeps the database inside the installation folder without making a
# running raw data directory a portable backup format.
USER root
