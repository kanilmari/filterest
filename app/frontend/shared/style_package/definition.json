{
  "schema_version": 1,
  "manifest_fields": ["schema_version", "scopes"],
  "themes": ["light", "dark"],
  "theme_rule": "explicit-containers-independent-overrides",
  "assignment_costs": {"token": 1, "language_font_slot": 1},
  "limits": {"manifest_bytes": 65536, "assignments": 128, "font_faces": 12, "font_face_bytes": 20971520, "font_total_bytes": 62914560, "json_depth": 24},
  "font_roles": ["body", "display", "emphasis"],
  "font_binding_fields": ["default", "languages"],
  "font_reference_pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
  "language_pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
  "color_pattern": "^#[0-9a-fA-F]{6}$",
  "scopes": {
    "site": {"selector": "body", "parent": null},
    "home": {"selector": ".front-page", "parent": "site"},
    "home-hero": {"selector": ".front-page-hero", "parent": "home"},
    "navigation-header": {"selector": ".hero-dataset-tabs", "parent": "site"},
    "primary-button": {"selector": ".fw-btn--primary", "parent": "site"},
    "cards": {"selector": ".fw-card, .product-card-view", "parent": "site"}
  },
  "reveal_presets": {
    "off": {"duration_ms": 0, "distance_px": 0, "stagger_ms": 0},
    "fade": {"duration_ms": 240, "distance_px": 0, "stagger_ms": 0},
    "fade-up": {"duration_ms": 320, "distance_px": 12, "stagger_ms": 60}
  },
  "default_reveal": "off",
  "shadow_presets": {
    "none": "none",
    "soft": "0 1px 2px rgb(0 0 0 / 10%)",
    "raised": "0 6px 14px rgb(0 0 0 / 15%)"
  },
  "reserved": {
    "site-presentation": {"definition": "../dataset_appearance/definition.json", "fields": ["active_tab_fade", "active_tab_max_opacity", "active_tab_glow_intensity", "active_tab_glow_width", "active_tab_glow_blur", "active_filter_remove_side", "brand_color"], "css": ["--brand-hue", "--brand-sat", "--brand-light", "--color-brand", "--color-brand-hover", "--color-brand-active", "--primary_color", "--primary_color_hover", "--primary_text_color", "--navtab-active-fade-width", "--navtab-active-max-opacity", "--navtab-active-glow-intensity", "--navtab-active-glow-width", "--navtab-active-glow-blur"]},
    "home-presentation": {"definition": "../front_page_presentation/definition.json", "fields": ["anchor", "horizontal_margin_px", "vertical_margin_px", "alignment", "max_width_px", "light_wash", "light_opacity", "dark_wash", "dark_opacity", "text_style"], "css": ["--home-text-horizontal-margin", "--home-text-vertical-margin", "--home-text-max-width", "--home-text-min-width", "--home-light-wash", "--home-light-opacity", "--home-dark-wash", "--home-dark-opacity", "--home-media-wash", "--home-media-opacity", "--home-wash-colour", "--front-page-background-2160", "--front-page-background-1000", "--front-page-video-fade", "--home-story-text", "--home-story-soft", "--home-story-accent", "--home-story-title-shadow", "--home-story-text-shadow", "--home-reveal-start", "--home-reveal-interval", "--line-index"]},
    "dataset-appearance": {"definition": "../dataset_appearance/definition.json", "fields": ["light.oval_enabled", "light.oval_width", "light.oval_height", "light.oval_position_y", "light.center_opacity", "light.mid_opacity", "light.edge_opacity", "light.center_stop", "light.mid_stop", "light.edge_stop", "light.image_opacity", "light.overlay_opacity", "light.image_blur", "dark.oval_enabled", "dark.oval_width", "dark.oval_height", "dark.oval_position_y", "dark.center_opacity", "dark.mid_opacity", "dark.edge_opacity", "dark.center_stop", "dark.mid_stop", "dark.edge_stop", "dark.image_opacity", "dark.overlay_opacity", "dark.image_blur", "hero_extra_height", "hero_bottom_fade", "image_blur", "card_image_width", "card_image_presentation", "article_image_caption_position", "card_show_all_fields", "label_value_layout", "card_style_variant", "card_description_lines", "card_detail_columns", "filterbar_content_top_space"], "css": ["--dataset-background-dark-image-blur", "--dataset-background-image-blur", "--dataset-background-light-image-blur", "--dataset-cover-dark-image-blur", "--dataset-cover-dark-image-opacity", "--dataset-cover-dark-mask-center-opacity", "--dataset-cover-dark-mask-center-stop", "--dataset-cover-dark-mask-edge-opacity", "--dataset-cover-dark-mask-edge-stop", "--dataset-cover-dark-mask-image", "--dataset-cover-dark-mask-mid-opacity", "--dataset-cover-dark-mask-mid-stop", "--dataset-cover-dark-mask-oval-x", "--dataset-cover-dark-mask-oval-y", "--dataset-cover-dark-mask-position-y", "--dataset-cover-dark-overlay-opacity", "--dataset-cover-hero-bottom-fade", "--dataset-cover-hero-extra-height", "--dataset-cover-image-bleed", "--dataset-cover-image-blur", "--dataset-cover-image-opacity", "--dataset-cover-light-image-blur", "--dataset-cover-light-image-opacity", "--dataset-cover-light-mask-center-opacity", "--dataset-cover-light-mask-center-stop", "--dataset-cover-light-mask-edge-opacity", "--dataset-cover-light-mask-edge-stop", "--dataset-cover-light-mask-image", "--dataset-cover-light-mask-mid-opacity", "--dataset-cover-light-mask-mid-stop", "--dataset-cover-light-mask-oval-x", "--dataset-cover-light-mask-oval-y", "--dataset-cover-light-mask-position-y", "--dataset-cover-light-overlay-opacity", "--dataset-cover-mask-center-opacity", "--dataset-cover-mask-center-stop", "--dataset-cover-mask-edge-opacity", "--dataset-cover-mask-edge-stop", "--dataset-cover-mask-image", "--dataset-cover-mask-mid-opacity", "--dataset-cover-mask-mid-stop", "--dataset-cover-mask-oval-x", "--dataset-cover-mask-oval-y", "--dataset-cover-mask-position-y", "--dataset-cover-overlay-opacity", "--dataset-cover-image", "--dataset-background-image", "--card_image_large_width", "--card-description-lines", "--filterbar-content-top-space"]}
  },
  "tokens": {
    "font.body": {"type": "font_binding", "css": "--font-body", "scopes": ["site", "home", "home-hero", "navigation-header", "primary-button", "cards"], "owner": "package", "role": "body"},
    "font.display": {"type": "font_binding", "css": "--font-display", "scopes": ["site", "home", "home-hero", "navigation-header", "primary-button", "cards"], "owner": "package", "role": "display"},
    "font.emphasis": {"type": "font_binding", "css": "--font-emphasis", "scopes": ["site", "home", "home-hero", "navigation-header", "primary-button", "cards"], "owner": "package", "role": "emphasis"},
    "body.letter-spacing": {"type": "length", "css": "--body-letter-spacing", "scopes": ["site"], "owner": "package", "units": {"px": {"min": -0.5, "max": 2}}},
    "body.line-height": {"type": "number", "css": "--body-line-height", "scopes": ["site"], "owner": "package", "min": 1.2, "max": 2},
    "heading.size": {"type": "responsive_size", "css": "--heading-size", "scopes": ["home", "home-hero"], "owner": "package", "units": {"rem": {"min": 1, "max": 8}, "vw": {"min": 1, "max": 8}}, "fields": {"min": "rem", "preferred": "vw", "max": "rem"}},
    "heading.weight": {"type": "integer", "css": "--heading-weight", "scopes": ["home", "home-hero"], "owner": "package", "min": 400, "max": 800},
    "heading.color": {"type": "color", "css": "--home-heading-color", "scopes": ["home", "home-hero"], "owner": "package"},
    "heading.letter-spacing": {"type": "length", "css": "--heading-letter-spacing", "scopes": ["home", "home-hero"], "owner": "package", "units": {"em": {"min": -0.08, "max": 0.2}}},
    "heading.gap": {"type": "length", "css": "--heading-gap", "scopes": ["home", "home-hero"], "owner": "package", "units": {"px": {"min": 0, "max": 64}}},
    "home.slogan-size": {"type": "length", "css": "--home-slogan-size", "scopes": ["home", "home-hero"], "owner": "package", "units": {"rem": {"min": 1, "max": 3}}},
    "home.description-size": {"type": "length", "css": "--home-description-size", "scopes": ["home", "home-hero"], "owner": "package", "units": {"rem": {"min": 0.875, "max": 2}}},
    "home.paragraph-gap": {"type": "length", "css": "--home-paragraph-gap", "scopes": ["home", "home-hero"], "owner": "package", "units": {"em": {"min": 0, "max": 3}}},
    "home.block-gap": {"type": "length", "css": "--home-block-gap", "scopes": ["home"], "owner": "package", "units": {"rem": {"min": 0, "max": 4}}},
    "home.block-padding": {"type": "length", "css": "--home-block-padding", "scopes": ["home"], "owner": "package", "units": {"rem": {"min": 0, "max": 4}}},
    "home.block-radius": {"type": "length", "css": "--home-block-radius", "scopes": ["home"], "owner": "package", "units": {"px": {"min": 0, "max": 32}}},
    "home.block-background": {"type": "color", "css": "--home-block-background", "scopes": ["home"], "owner": "package"},
    "home.reveal": {"type": "reveal_preset", "css": "--home-reveal-preset", "scopes": ["home", "home-hero"], "owner": "package"},
    "navigation.gap": {"type": "length", "css": "--navigation-gap", "scopes": ["navigation-header"], "owner": "package", "units": {"px": {"min": 0, "max": 32}}},
    "navigation.padding-block": {"type": "length", "css": "--navigation-padding-block", "scopes": ["navigation-header"], "owner": "package", "units": {"px": {"min": 0, "max": 24}}},
    "navigation.padding-inline": {"type": "length", "css": "--navigation-padding-inline", "scopes": ["navigation-header"], "owner": "package", "units": {"px": {"min": 4, "max": 32}}},
    "navigation.radius": {"type": "length", "css": "--navigation-radius", "scopes": ["navigation-header"], "owner": "package", "units": {"px": {"min": 0, "max": 24}}},
    "navigation.size": {"type": "length", "css": "--navigation-size", "scopes": ["navigation-header"], "owner": "package", "units": {"rem": {"min": 0.75, "max": 1.5}}},
    "navigation.line-height": {"type": "number", "css": "--navigation-line-height", "scopes": ["navigation-header"], "owner": "package", "min": 1.2, "max": 2},
    "navigation.background": {"type": "color", "css": "--navigation-background", "scopes": ["navigation-header"], "owner": "package"},
    "navigation.text": {"type": "color", "css": "--navigation-text", "scopes": ["navigation-header"], "owner": "package"},
    "button.padding-block": {"type": "length", "css": "--primary-button-padding-block", "scopes": ["primary-button"], "owner": "package", "units": {"rem": {"min": 0.25, "max": 1.5}}},
    "button.padding-inline": {"type": "length", "css": "--primary-button-padding-inline", "scopes": ["primary-button"], "owner": "package", "units": {"rem": {"min": 0.5, "max": 3}}},
    "button.size": {"type": "length", "css": "--primary-button-size", "scopes": ["primary-button"], "owner": "package", "units": {"rem": {"min": 0.75, "max": 1.5}}},
    "button.radius": {"type": "length", "css": "--primary-button-radius", "scopes": ["primary-button"], "owner": "package", "units": {"px": {"min": 0, "max": 32}}},
    "button.shadow": {"type": "shadow_preset", "css": "--primary-button-shadow", "scopes": ["primary-button"], "owner": "package"},
    "button.background": {"type": "color", "css": "--primary-button-background", "scopes": ["primary-button"], "owner": "package"},
    "button.text": {"type": "color", "css": "--primary-button-text", "scopes": ["primary-button"], "owner": "package"},
    "card.radius": {"type": "length", "css": "--style-card-radius", "scopes": ["cards"], "owner": "package", "units": {"px": {"min": 0, "max": 32}}},
    "card.padding": {"type": "length", "css": "--style-card-padding", "scopes": ["cards"], "owner": "package", "units": {"px": {"min": 0, "max": 48}}},
    "card.gap": {"type": "length", "css": "--style-card-gap", "scopes": ["cards"], "owner": "package", "units": {"px": {"min": 0, "max": 32}}},
    "card.background": {"type": "color", "css": "--style-card-background", "scopes": ["cards"], "owner": "package"},
    "card.shadow": {"type": "shadow_preset", "css": "--style-card-shadow", "scopes": ["cards"], "owner": "package"}
  }
}
