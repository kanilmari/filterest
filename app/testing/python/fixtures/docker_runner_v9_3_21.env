# Synthetic established v9.3.21-style Docker settings; no operator secrets.
FILTEREST_INSTALL_PROFILE=docker
ENVIRONMENT_TYPE=prod
COMPOSE_PROJECT_NAME=filterest-abc12345
INSTANCE_NAME=filterest-abc12345
FILTEREST_LOCAL_TLS=true
APP_PORT=8100
DB_PORT=5433
BASE_URL=https://localhost:8100
DB_ADMIN_PASSWORD=synthetic-admin
DB_PASSWORD=synthetic-admin
DB_READONLY_PASSWORD=synthetic-readonly
DB_CONFIDENTIAL_PASSWORD=synthetic-confidential
DB_BASIC_PASSWORD=synthetic-basic
DB_GUEST_PASSWORD=synthetic-guest
SESSION_SECRET_KEY=synthetic-session-secret
SESSION_KEY=synthetic-session-key
FILTEREST_RUNTIME_UID=<uid>
FILTEREST_RUNTIME_GID=<gid>
FILTEREST_APP_VERSION=9.3.21
FILTEREST_DB_VERSION=9.9.2
