# Defines local-only paths for canonical and public Filterest source checkouts.
# Separates runtime data, protected settings, caches, and generated test output.
# Keeps a copied folder safe to initialize as Git without exposing local secrets.
# Public bootstrap fixture exceptions are added by the release generator when needed.
node_modules/
/config/
/keys/
/projects/
/data/
/backups/

# Flat-layout compatibility paths remain ignored until all existing installs
# have migrated to the installation-root directories above.
/runtime/
/storage/
/storage_deleted/
/db_backups/

.env
.env.*
!.env.example
dev_env.txt
dev_env_test_creds.txt
/filterest.paths.local
*.crt
*.pem
*.key
*.log
*.tmp

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.queen/
agent_tasks/

coverage/
coverage.out

.vscode/
.idea/
.DS_Store
Thumbs.db
