# Testing-only environment file.
# Editing this file does NOT modify the real project `.env`.
# Use it as a safe placeholder bundle for local tests, fixtures, and docs.
# Most values rarely need changes, but new variables may be added as the codebase evolves.

# Core runtime
ENVIRONMENT_TYPE=dev
PORT=8082
APP_PORT=8082
BASE_URL=http://localhost:8082
SITE_NAME=Easelect
DEV_MODE=false
MAINTENANCE_MODE=false
ALLOW_INSECURE_DEV_PROXY=false
ENABLE_API_LANGUAGE=false
ENABLE_SQL_MIGRATIONS=false
REQUEST_LOGGING_DEBUG=false
SESSION_LOG=0

# TLS for local development
TLS_CERT_FILE=dev-cert.crt
TLS_KEY_FILE=dev-cert.key

# Session signing and encryption
SESSION_KEY=CHANGE_ME_session_signing_key
SESSION_SECRET_KEY=CHANGE_ME_session_encryption_key

# Database connection for the native local instance
DB_HOST=localhost
DB_PORT=5433
DB_SSLMODE=disable
DB_NAME=easelect
DB_ADMIN_USER=admin_user
DB_ADMIN_PASSWORD=CHANGE_ME_admin_password
DB_READONLY_USER=readonly_user
DB_READONLY_PASSWORD=CHANGE_ME_readonly_password
DB_CONFIDENTIAL_USER=confidential_user
DB_CONFIDENTIAL_PASSWORD=CHANGE_ME_confidential_password
DB_BASIC_USER=basic_user
DB_BASIC_PASSWORD=CHANGE_ME_basic_password
DB_GUEST_USER=guest_user
DB_GUEST_PASSWORD=CHANGE_ME_guest_password

# Search / AI defaults
OPENAI_API_KEY=
OPENAI_API_MODEL=gpt-5.1
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_TABLE_STREAM_PROMPT=
USE_ANTHROPIC=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
EMBEDDING_PROVIDER=openai
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=
AI_TRANSLATOR_SYSTEM_MESSAGE=

# Integrations used by specific apps
HERE_API_KEY=
POSTMARK_API_KEY=
EMAIL_FROM_ADDRESS=
LOGIN_OTP_CODE=
MCP_SERVICE_TOKEN=
REGFETCH_WORKER_SERVICE_TOKEN=
MML_API_KEY=
PRH_API_BASE_URL=

# Tukisuu app defaults
TUKISUU_BASE_URL=
TUKISUU_PURCHASE_SECRET=
TUKISUU_API_KEY=
TUKISUU_MODEL=
TUKISUU_FALLBACK_MODEL=
TUKISUU_SYSTEM_PROMPT=
TUKISUU_DOMAIN=
TUKISUU_PRICE_PER_MILLION_INPUT=
TUKISUU_PRICE_PER_MILLION_OUTPUT=
HUMAN_SUPPORT_EMAIL=

# Payment gateway defaults
REVOLUT_WEBHOOK_SECRET=
PAYMENT_CALLBACK_SECRET=
REVOLUT_MERCHANT_API_SECRET_KEY=
REVOLUT_MERCHANT_API_PUBLIC_KEY=
SANDBOX_MODE=false

# Miscellaneous runtime toggles
INSTANCE_NAME=
EASELECT_START_MS=
